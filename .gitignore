# Ignore everything in the WordPress root by default
*

# Allow .gitignore and agent instructions
!.gitignore
!AGENTS.md

# Traverse and track only custom theme code
!wp-content/
!wp-content/themes/
!wp-content/themes/giao-dien/
!wp-content/themes/giao-dien/*/
!wp-content/themes/giao-dien/*/*/
!wp-content/themes/giao-dien/**

# Traverse and track only custom plugins
!wp-content/plugins/
!wp-content/plugins/ocean-contact-buttons/
!wp-content/plugins/ocean-contact-buttons/*/
!wp-content/plugins/ocean-contact-buttons/*/*/
!wp-content/plugins/ocean-contact-buttons/**

# Traverse and track Novamira sandbox scripts
!wp-content/novamira-sandbox/
!wp-content/novamira-sandbox/*/
!wp-content/novamira-sandbox/**

# Explicit safeguards: never track media uploads, database dumps, or archives
wp-content/uploads/
**/uploads/
*.sql
*.sql.gz
*.sqlite
*.db
*.daf
